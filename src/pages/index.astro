---
import { getPageStyles } from "../lib/page-styles"
import Document from "../layouts/Document.astro"
import Page, { Head } from "../views/index.tsx"
import { getSummaries } from "../lib/content"
const posts = await getSummaries()
const styles = getPageStyles(Page, { posts })
---
<Document styles={styles}>
  <Head slot="head" />
  <Page posts={posts} client:load />
</Document>
