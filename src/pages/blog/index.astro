---
import { getPageStyles } from "../../lib/page-styles"
import Document from "../../layouts/Document.astro"
import Page, { Head } from "../../views/blog/index.tsx"
import { getSummaries } from "../../lib/content"
const data = { allMarkdownRemark: { nodes: await getSummaries(true) } }
const styles = getPageStyles(Page, { data })
---
<Document styles={styles}>
  <Head slot="head" data={data} />
  <Page data={data} client:load />
</Document>
