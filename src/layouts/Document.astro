---
import { ClientRouter } from "astro:transitions"
import { googleFonts } from "../theme/theme.config"
import manifestSource from "../../static/manifest.webmanifest?raw"
const manifest = JSON.parse(manifestSource) as { icons: { src: string; sizes: string }[] }
const iconVersion = manifest.icons[0].src.split("?")[1]
const { styles } = Astro.props
---
<!doctype html>
<html lang="en">
  <head>
    {styles.map(style => <style is:inline data-emotion={`${style.key} ${style.ids.join(" ")}`} set:html={style.css} />)}
    <meta charset="utf-8" />
    <meta name="viewport" content="initial-scale=1, width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href={googleFonts} rel="stylesheet" />
    <link rel="icon" href={`/favicon-32x32.png?${iconVersion}`} type="image/png" />
    <link rel="manifest" href="/manifest.webmanifest" crossorigin="anonymous" />
    {manifest.icons.map(icon => <link rel="apple-touch-icon" sizes={icon.sizes} href={`/${icon.src}`} />)}
    <ClientRouter />
    <slot name="head" />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-J0ENF326VF"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-J0ENF326VF');
    </script>
    <style is:global>
      /* Match the previous instantaneous route swap, without a cross-fade. */
      ::view-transition-old(root), ::view-transition-new(root) { animation: none; }
    </style>
  </head>
  <body><slot /></body>
</html>
